# Frontend Environment Variables
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
REACT_APP_IPFS_API=http://localhost:5001/api/v0

# Pinata API (para upload a IPFS)
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Ethereum RPC (opcional, si usas provider personalizado)
REACT_APP_RPC_URL=http://localhost:8545
